PORT=5000
# ריק = MongoDB מקומי אוטומטי לפיתוח. לייצור: כתובת Atlas
MONGO_URI=
# חובה בייצור - מחרוזת אקראית ארוכה
JWT_SECRET=
# console = הקוד מודפס בלוג של השרת במקום SMS אמיתי
SMS_PROVIDER=console
# console = המייל מודפס בלוג של השרת (פיתוח בלבד). smtp = שליחה אמיתית - חובה בייצור
# ל-Gmail: SMTP_USER = כתובת הג'ימייל, SMTP_PASS = "סיסמת אפליקציה" (לא הסיסמה הרגילה)
# בדיקה: npm run test-mail -- your@email.com
MAIL_PROVIDER=console
MAIL_FROM="סטודיו פילאטיס <studio@example.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NODE_ENV=development
# ייצור בלבד: המנהלת הראשונה נוצרת מכאן כשאין עדיין מנהלת במסד
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
